---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

// 示例图库/相册数据 (后续可在 src/content/gallery 或 json 中扩展)
const photos = [
  {
    title: "悉尼云端机房与代码视界",
    category: "赛博纪实",
    date: "2026-08-11",
    url: "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80",
    desc: "AWS Sydney 节点与数字生命体彼岸的初次呼应。"
  },
  {
    title: "彼岸的灵感海岸",
    category: "生活&沉思",
    date: "2026-08-12",
    url: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80",
    desc: "守在岸边，等待每一次深度的思考与创造落地。"
  },
  {
    title: "赛博霓虹与未来架构",
    category: "架构美学",
    date: "2026-08-13",
    url: "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=800&q=80",
    desc: "零成本高可用架构：GitHub Pages + AWS Lambda + Sydney Docker。"
  },
  {
    title: "黑客夜间代码工坊",
    category: "赛博纪实",
    date: "2026-08-10",
    url: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80",
    desc: "用技术创造自由，让计算机替自己工作。"
  },
  {
    title: "星空下的数据流动",
    category: "生活&沉思",
    date: "2026-08-09",
    url: "https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=800&q=80",
    desc: "自由不是终点，而是掌控人生的工具。"
  },
  {
    title: "云原生与节点网格",
    category: "架构美学",
    date: "2026-08-08",
    url: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80",
    desc: "连接、感知与协同计算。"
  }
];
---

<Layout title={`图影相册 | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle="🖼️ 赛博画廊与图影空间" pageDesc="记录创造者的瞬间、架构美学与彼岸的数字思考">
    <!-- 分类筛选与数量提示 -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-accent/20 bg-accent/5 p-4 backdrop-blur-sm">
      <div class="flex items-center gap-2">
        <span class="text-xl">📸</span>
        <span class="font-medium text-foreground">画廊快照 ({photos.length} 张图片)</span>
      </div>
      <p class="text-xs text-foreground/70">
        💡 点击图片可查看高清大图与详细故事记录
      </p>
    </div>

    <!-- Waterfall / Masonry Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((photo, index) => (
        <div class="group relative overflow-hidden rounded-2xl border border-accent/20 bg-background/50 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-accent hover:shadow-xl hover:shadow-accent/10">
          <!-- Image Container -->
          <div class="relative aspect-4/3 overflow-hidden bg-accent/10">
            <img
              src={photo.url}
              alt={photo.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <!-- Overlay Category Tag -->
            <div class="absolute top-3 left-3 rounded-full bg-background/80 px-3 py-1 text-xs font-semibold text-accent backdrop-blur-md">
              {photo.category}
            </div>
            <!-- Date Badge -->
            <div class="absolute top-3 right-3 rounded-full bg-black/50 px-2.5 py-1 text-[10px] text-white/90 backdrop-blur-md">
              {photo.date}
            </div>
          </div>

          <!-- Content Info -->
          <div class="p-4">
            <h3 class="text-base font-bold text-foreground transition-colors group-hover:text-accent">
              {photo.title}
            </h3>
            <p class="mt-1 text-xs text-foreground/70 line-clamp-2 leading-relaxed">
              {photo.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </Main>

  <Footer />
</Layout>
